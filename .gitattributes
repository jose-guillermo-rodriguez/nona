# Enforce LF endings bit-for-bit across all text files
* text=auto eol=lf

# Explicit LF enforcement for critical build artifacts and scripts
*.rs text eol=lf
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
Makefile text eol=lf
Dockerfile* text eol=lf
Containerfile text eol=lf

# Binary file declarations (prevent CRLF transformations and text parsing)
*.fst binary
*.png binary
*.jpg binary
*.jpeg binary
*.a binary
*.so binary
*.dylib binary
